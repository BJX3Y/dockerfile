# 选用 alpine 3.18 作为基础镜像（轻量，国内源易访问）
FROM alpine:3.18

# 配置国内 Alpine 源（加速依赖安装）
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories

# 安装依赖（curl 用于下载二进制包，bash 用于启动脚本）
RUN apk add --no-cache curl bash ca-certificates

# 定义 etcd 版本（可修改为 3.5.11/3.5 等）
ARG ETCD_VERSION=3.5.10
ARG ARCH=amd64

# 下载并解压 etcd 官方二进制包（国内可访问 GitHub Release）
RUN curl -L https://github.com/etcd-io/etcd/releases/download/v${ETCD_VERSION}/etcd-v${ETCD_VERSION}-linux-${ARCH}.tar.gz \
    | tar -xz --strip-components=1 -C /usr/local/bin/ etcd-v${ETCD_VERSION}-linux-${ARCH}/etcd \
    && curl -L https://github.com/etcd-io/etcd/releases/download/v${ETCD_VERSION}/etcd-v${ETCD_VERSION}-linux-${ARCH}.tar.gz \
    | tar -xz --strip-components=1 -C /usr/local/bin/ etcd-v${ETCD_VERSION}-linux-${ARCH}/etcdctl \
    && curl -L https://github.com/etcd-io/etcd/releases/download/v${ETCD_VERSION}/etcd-v${ETCD_VERSION}-linux-${ARCH}.tar.gz \
    | tar -xz --strip-components=1 -C /usr/local/bin/ etcd-v${ETCD_VERSION}-linux-${ARCH}/etcdutl

# 创建 etcd 数据目录（与官方镜像一致）
RUN mkdir -p /x3y/etcd/data \
    && chmod 777 /x3y/etcd/data

# 暴露端口（client:2379，peer:2380）
EXPOSE 2379 2380

# 设置环境变量
ENV ETCD_DATA_DIR=/x3y/etcd/data \
    ETCD_LISTEN_CLIENT_URLS=http://0.0.0.0:2379 \
    ETCD_ADVERTISE_CLIENT_URLS=http://0.0.0.0:2379

# 启动命令（默认启动单节点 etcd）
CMD ["etcd", "--name=etcd-node", "--listen-peer-urls=http://0.0.0.0:2380", "--initial-advertise-peer-urls=http://0.0.0.0:2380", "--initial-cluster=etcd-node=http://0.0.0.0:2380", "--initial-cluster-state=new"]